{
  "name": "survey-app",
  "version": "1.0.0",
  "private": true,
  "description": "Public survey website that stores responses in Google Sheets via Google Apps Script.",
  "license": "MIT",
  "scripts": {
    "start": "node tools/dev-server.js",
    "start:mock": "node tools/dev-server.js --mock",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
